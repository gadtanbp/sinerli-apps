{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Hanya jendela utama (UI bawaan) yang boleh memanggil perintah native.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-theme",
    "core:window:allow-set-focus",
    "opener:default",
    "dialog:default",
    "deep-link:default"
  ]
}
